# Official documentation uses MODEL_API_KEY. META_API_KEY is an accepted alias.
MODEL_API_KEY=
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
# Optional token prices per million; leave blank if not verified.
META_INPUT_USD_PER_MILLION=
META_OUTPUT_USD_PER_MILLION=

# Recommended for a private deployment. Share only with authorized demo users.
BRIDGEVOICE_ACCESS_TOKEN=

# Optional server-side Microsoft Azure Speech credentials (separate from Meta).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Experimental telephone module: disabled. Enabling alone never places calls.
ENABLE_BRIDGE_CALLS=false
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Process-local safety cap for Meta model calls per UTC day.
BRIDGEVOICE_MAX_MODEL_CALLS_PER_DAY=100
